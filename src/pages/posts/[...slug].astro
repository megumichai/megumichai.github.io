---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostList from "../../components/PostList.astro";
import PostDate from "../../components/PostDate.astro";
import { byPinnedThenDate } from "../../utils/posts";

export async function getStaticPaths() {
  const posts = await getCollection(
    "posts",
    ({ data }) => !data.draft && data.type !== "demo",
  );
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Same ordering the home list uses; the dock only shows the two entries
// adjacent to the current one (the previous and next entries).
const ordered = (await getCollection("posts"))
  .filter((entry) => !entry.data.draft)
  .sort(byPinnedThenDate);

const current = ordered.findIndex((entry) => entry.id === post.id);
const neighbours = ordered.filter(
  (_, index) => index === current - 1 || index === current + 1,
);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  mainClass="site-main--detail"
  footerClass="site-footer--detail"
>
  <article class="post">
    <header class="post-header" transition:name={post.id}>
      <h1>{post.data.title}</h1>
      <p class="post-meta">
        <PostDate
          date={post.data.pubDate}
          live={post.data.dateMode === "today"}
        />
        {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
      </p>
    </header>

    <div class="post-content">
      <Content />
    </div>

    <footer class="post-footer">
      <a href="/">← 返回首页</a>
    </footer>
  </article>

  <div class="post-list-dock">
    <PostList posts={neighbours} />
  </div>
</BaseLayout>

<style>
  .post {
    max-width: 680px;
    margin: 25vh auto 0;
  }

  /*
   * The list is docked to the right viewport edge, pushed out so exactly half
   * of it stays on screen. The page leaves room for that half via
   * `.site-main--detail`'s padding, so the article is centered in what's left.
   */
  .post-list-dock {
    position: fixed;
    /* Match the home list's resting position (main's 48px top padding + 25vh)
       so the morph is a pure horizontal slide. */
    top: calc(25vh + 48px);
    left: 100vw;
    z-index: 2;
    width: 32rem;
    max-width: 32rem;
    transform: translateX(-50%);
  }

  @media (max-width: 900px) {
    .post-list-dock {
      display: none;
    }
  }

  /*
   * The heading pins to the top of the viewport while the article scrolls
   * underneath it, then a scroll-driven timeline grows and dims it until it
   * reads as a faint watermark sitting *behind* the body copy. It lives in the
   * background, so it must not swallow clicks meant for the article.
   */
  .post-header {
    position: sticky;
    top: 0;
    z-index: 0;
    margin-bottom: 32px;
    pointer-events: none;
  }

  .post-header h1 {
    margin: 0 0 12px;
    font-size: 1.875rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  /*
   * Scroll-driven "recede" timeline. Guarded by @supports so that browsers
   * without scroll-driven animations simply keep the plain, opaque heading
   * (the shorthand alone would otherwise jump straight to the end state).
   *
   * The article starts 25vh down the page, so it pins after ~25vh of scroll —
   * the range ends there, meaning the title has hollowed out into an outline
   * *by the time it reaches the top*, where it then stays put as a watermark
   * behind the body copy.
   */
  @supports (animation-timeline: scroll()) {
    .post-header h1 {
      animation: title-recede linear both;
      animation-timeline: scroll(root block);
      animation-range: 0 25vh;
      /* The fill turns transparent, so `currentColor` would vanish with it —
         the outline needs a colour of its own. */
      -webkit-text-stroke-color: var(--text-muted);
    }

    /* Dates and tags clear out on the way up, before the heading takes over. */
    .post-meta {
      animation: meta-recede linear both;
      animation-timeline: scroll(root block);
      animation-range: 5vh 20vh;
    }

    @keyframes title-recede {
      from {
        color: var(--text);
        opacity: 1;
        -webkit-text-stroke-width: 0;
      }
      to {
        /* Only the outline is left: transparent fill, stroked glyphs. */
        color: transparent;
        opacity: 0.3;
        -webkit-text-stroke-width: 1px;
      }
    }

    @keyframes meta-recede {
      to {
        opacity: 0;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      /* No watermark animation, so don't pin the opaque heading over the copy. */
      .post-header {
        top: -5rem;
      }

      .post-header h1,
      .post-meta {
        animation: none;
      }
    }
  }

  /*
   * Fallback for browsers without scroll-driven animations: the heading would
   * otherwise stay pinned at the top, fully opaque, on top of the article. Park
   * it above the viewport instead so it simply scrolls away.
   */
  @supports not (animation-timeline: scroll()) {
    .post-header {
      top: -5rem;
    }
  }

  .tag {
    padding: 2px 9px;
    border-radius: var(--radius-pill);
    background-color: var(--surface-recessed);
    color: var(--text-secondary);
    font-size: 0.75rem;
  }

  .post-content {
    position: relative;
    z-index: 1;
    font-size: 1.0625rem;
    /* Named so the entrance can play on the transition snapshot below. */
    view-transition-name: post-content;
    animation: post-content-in 0.5s cubic-bezier(0.4, 0, 0.2, 1) both;
  }

  /* Slide up + fade in as the article enters. */
  @keyframes post-content-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-content {
      animation: none;
    }
  }

  .post-content :global(h2) {
    margin: 2em 0 0.6em;
    font-size: 1.375rem;
    line-height: 1.4;
  }

  .post-content :global(h3) {
    margin: 1.6em 0 0.5em;
    font-size: 1.125rem;
  }

  .post-content :global(p) {
    margin: 0 0 1.2em;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin: 0 0 1.2em;
    padding-left: 1.4em;
  }

  .post-content :global(li) {
    margin-bottom: 0.4em;
  }

  .post-content :global(blockquote) {
    margin: 1.5em 0;
    padding: 0.25em 1.1em;
    border-left: 3px solid var(--accent);
    background-color: var(--surface-recessed);
    color: var(--text-secondary);
  }

  .post-content :global(code) {
    padding: 0.15em 0.4em;
    border-radius: 4px;
    background-color: var(--code-inline-bg);
    font-size: 0.875em;
    font-family: var(--font-mono);
  }

  .post-content :global(pre) {
    margin: 0 0 1.4em;
    padding: 16px 18px;
    border-radius: var(--radius);
    background-color: var(--code-bg);
    color: var(--code-text);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .post-content :global(pre code) {
    padding: 0;
    background: none;
    color: inherit;
    font-size: inherit;
  }

  .post-content :global(hr) {
    margin: 2.5em 0;
    border: 0;
    border-top: 1px solid var(--border);
  }

  .post-footer {
    position: relative;
    z-index: 1;
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
    font-size: 0.9375rem;
  }
</style>

<style is:global>
  /*
   * When the article is navigated to (rather than loaded directly) the live
   * element is hidden behind the view-transition snapshot, so the entrance has
   * to be played by the snapshot's pseudo-element instead. This has to live
   * outside the scoped block: Astro's scoping would prefix it with the
   * component attribute and the selector would never match.
   */
  ::view-transition-new(post-content) {
    animation: post-content-in 0.5s cubic-bezier(0.4, 0, 0.2, 1) both;
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-new(post-content) {
      animation: none;
    }
  }
</style>
