---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostList from "../../components/PostList.astro";
import { formatDate } from "../../utils/date";

export async function getStaticPaths() {
  const posts = await getCollection(
    "posts",
    ({ data }) => !data.draft && data.type !== "demo",
  );
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Same ordered list that the home page shows, reused here so the list can be
// morphed (rather than removed) by the view transition.
const allPosts = (await getCollection("posts"))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  mainClass="site-main--detail"
>
  <article class="post">
    <header class="post-header">
      <h1 transition:name={`post-title-${post.id}`}>{post.data.title}</h1>
      <p class="post-meta">
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate)}
        </time>
        {
          post.data.tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))
        }
      </p>
    </header>

    <div class="post-content">
      <Content />
    </div>

    <footer class="post-footer">
      <a href="/">← 返回首页</a>
    </footer>
  </article>

  <div class="post-list-dock">
    <PostList posts={allPosts} />
  </div>
</BaseLayout>

<style>
  .post {
    max-width: 680px;
    margin: 25vh auto 0;
  }

  /*
   * The list is docked to the right viewport edge, pushed out so exactly half
   * of it stays on screen. The page leaves room for that half via
   * `.site-main--detail`'s padding, so the article is centered in what's left.
   */
  .post-list-dock {
    position: fixed;
    /* Match the home list's resting position (main's 48px top padding + 25vh)
       so the morph is a pure horizontal slide. */
    top: calc(25vh + 48px);
    left: 100vw;
    z-index: 2;
    width: 32rem;
    max-width: 32rem;
    transform: translateX(-50%);
  }

  @media (max-width: 900px) {
    .post-list-dock {
      display: none;
    }
  }

  .post-header {
    margin-bottom: 32px;
  }

  .post-header h1 {
    margin: 0 0 12px;
    font-size: 1.875rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .tag {
    padding: 2px 9px;
    border-radius: var(--radius-pill);
    background-color: var(--surface-recessed);
    color: var(--text-secondary);
    font-size: 0.75rem;
  }

  .post-content {
    font-size: 1.0625rem;
  }

  .post-content :global(h2) {
    margin: 2em 0 0.6em;
    font-size: 1.375rem;
    line-height: 1.4;
  }

  .post-content :global(h3) {
    margin: 1.6em 0 0.5em;
    font-size: 1.125rem;
  }

  .post-content :global(p) {
    margin: 0 0 1.2em;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin: 0 0 1.2em;
    padding-left: 1.4em;
  }

  .post-content :global(li) {
    margin-bottom: 0.4em;
  }

  .post-content :global(blockquote) {
    margin: 1.5em 0;
    padding: 0.25em 1.1em;
    border-left: 3px solid var(--accent);
    background-color: var(--surface-recessed);
    color: var(--text-secondary);
  }

  .post-content :global(code) {
    padding: 0.15em 0.4em;
    border-radius: 4px;
    background-color: var(--code-inline-bg);
    font-size: 0.875em;
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
  }

  .post-content :global(pre) {
    margin: 0 0 1.4em;
    padding: 16px 18px;
    border-radius: var(--radius);
    background-color: var(--code-bg);
    color: var(--code-text);
    overflow-x: auto;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .post-content :global(pre code) {
    padding: 0;
    background: none;
    color: inherit;
    font-size: inherit;
  }

  .post-content :global(hr) {
    margin: 2.5em 0;
    border: 0;
    border-top: 1px solid var(--border);
  }

  .post-footer {
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
    font-size: 0.9375rem;
  }
</style>
