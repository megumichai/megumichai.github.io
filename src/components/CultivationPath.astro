---
interface Realm {
  name: string;
  /** Sub-stages of the realm, e.g. ["前期", "中期", "后期"]. */
  sub?: string[];
}

interface Props {
  /** Realms in ascending order, lowest → highest. */
  realms?: Realm[];
  /** The realm currently being cultivated; must appear in `realms`. */
  current: string;
  /** Current sub-stage; must appear in the current realm's `sub`. */
  currentSub?: string;
}

const SUB_STAGES = ["前期", "中期", "后期"];

const {
  realms = [
    { name: "练气期", sub: SUB_STAGES },
    { name: "筑基期", sub: SUB_STAGES },
    { name: "结丹期", sub: SUB_STAGES },
    { name: "元婴期", sub: SUB_STAGES },
    { name: "化神期", sub: SUB_STAGES },
  ],
  current,
  currentSub,
} = Astro.props;

const realmIndex = realms.findIndex((realm) => realm.name === current);

/** Realms below the current one are done, the rest are still ahead. */
function realmState(index: number): "done" | "current" | "future" {
  if (index === realmIndex) return "current";
  return index < realmIndex ? "done" : "future";
}

/** Sub-stages are only ever listed for the current realm, so this just orders
    them relative to the one being cultivated. */
function subState(subIdx: number) {
  const subIndex = realms[realmIndex].sub?.indexOf(currentSub!) ?? -1;
  if (subIdx === subIndex) return "current";
  return subIdx < subIndex ? "done" : "future";
}
---

<ol class="cultivation" aria-label="境界">
  {
    realms.map((realm, realmIdx) => {
      const state = realmState(realmIdx);
      return (
        <li class={`realm realm--${state}`}>
          <span class="realm-name">{realm.name}</span>
          {/* Only the realm being cultivated needs its breakdown — completed
              and not-yet-reached realms list no sub-stages. */}
          {state === "current" && realm.sub && (
            <ol class="sub-stages">
              {realm.sub.map((sub, subIdx) => (
                <li class={`sub-stage sub-stage--${subState(subIdx)}`}>
                  <span class="sub-stage-name">{sub}</span>
                </li>
              ))}
            </ol>
          )}
        </li>
      );
    })
  }
</ol>

<style>
  .cultivation {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 1.5em 0;
    /* Room for the markers on the vertical rule. */
    padding: 0 0 0 1.25rem;
    border-left: 1px solid var(--border);
    list-style: none;
  }

  .realm {
    position: relative;
    margin: 0;
    line-height: 1.7;
  }

  /* Every stage except the current one sits back. The fade goes on the name,
     not the container: nested opacity would multiply and double-dim the
     sub-stages of a completed realm. */
  .realm--done > .realm-name,
  .realm--future > .realm-name,
  .sub-stage--done > .sub-stage-name,
  .sub-stage--future > .sub-stage-name {
    opacity: 0.5;
  }

  /* Stages already cultivated are crossed out. The 50% fade swallows the
     default hairline, so the line is drawn thicker and in the full text
     colour: after the dimming it still reads as a clear strike. */
  .realm--done > .realm-name,
  .sub-stage--done > .sub-stage-name {
    text-decoration: line-through;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--text);
  }

  .realm--current > .realm-name,
  .sub-stage--current > .sub-stage-name {
    color: var(--accent);
    font-weight: 600;
  }

  /* Marker sitting on the rule, centred on the 1px border. */
  .realm::before {
    content: "";
    position: absolute;
    left: -1.25rem;
    top: 0.65em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--border-strong);
    transform: translateX(-100%);
  }

  .realm--current::before {
    background-color: var(--accent);
  }

  .sub-stages {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 2px 0 0;
    padding: 0;
    list-style: none;
  }

  .sub-stage {
    margin: 0;
    line-height: 1.7;
  }
</style>
